---
import articles from '../data/articles.json';

const totalArticles = articles.length;
---

<aside class="sidebar glass-ground">
  <div class="info-profile">
    <div class="avatar-container">
      <img alt="头像" src="https://avatars.githubusercontent.com/u/208222094?v=4" class="avatar">
    </div>
    <div class="info-text">
      <h2 id="user-name">Kerorry</h2>
      <p>一位菜鸟程序员</p>
    </div>
  </div>

  <div class="line"></div>

  <div class="sidebar-section stats-section">
    <h3>统计项</h3>
    <div class="stats-container">
      <div class="stat-item">
        <div class="stat-number" id="stat-repos">0</div>
        <div class="stat-repos">仓库</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" id="stat-stars">0</div>
        <div class="stat-stars">星标</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" id="stat-followers">0</div>
        <div class="stat-followers">粉丝</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" id="stat-articles">{totalArticles}</div>
        <div class="stat-articles">文章</div>
      </div>
    </div>
  </div>

  <div class="line"></div>

  <div class="sidebar-section">
    <h3>菜单</h3>
    <ul class="menu-links">
      <li>
        <a href="/"><i class="fas fa-home"></i> 首页</a>
      </li>
      <li>
        <a href="/article/"><i class="fas fa-folder"></i> 文章</a>
      </li>
    </ul>
  </div>

  <div class="line"></div>

  <div class="sidebar-section">
    <h3>标签</h3>
    <div class="tags">
      <span class="tag">Python</span>
    </div>
  </div>

  <div class="sidebar-section">
    <h3>联系</h3>
    <div class="social-links">
      <a href="https://github.com/Kerorry" target="_blank"><i class="fab fa-github"></i></a>
    </div>
  </div>
</aside>