---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面 404">
  <article class="post glass-ground blog-post" style="text-align: center;">
    <h1 class="post-title" style="font-size: 80px; margin-bottom: 0; line-height: 1.2;">404</h1>
    <h2 style="font-weight: 400; margin-bottom: 20px; color: rgba(54, 54, 54, 0.85);">页面走丢了</h2>
    <div class="post-content">
      <p style="margin-bottom: 25px;">抱歉，您访问的页面已被删除或地址有误。</p>
      <a href="/" class="read-more" style="display: inline-block;">
        <i class="fas fa-home"></i> 返回首页
      </a>
    </div>
  </article>
</BaseLayout>